// Win32, D3D11, DXGI, the shader compiler and WIC, for rasm programs.
//
// The C headers the data file includes, and rinbind's declarations of
// everything in them (gen/win32_d3d11.rin, made by gen/gen_bindings.py). A rin
// file, so rin's syntax: `;` ends a declaration here.
cinclude "windows.h"
cinclude "d3d11.h"
cinclude "dxgi.h"
cinclude "d3dcompiler.h"
cinclude "wincodec.h"
import "gen/win32_d3d11.rin"

// Data the headers declare `extern` and dxguid.lib, uuid.lib and
// windowscodecs.lib define. A global with no initialiser is one C already has.
IID_ID3D11Texture2D: IID;
CLSID_WICImagingFactory2: GUID;            // the header's CLSID_WICImagingFactory
IID_IWICImagingFactory: IID;
GUID_WICPixelFormat32bppRGBA: GUID;
GUID_WICPixelFormat32bppBGRA: GUID;
GUID_ContainerFormatPng: GUID;
