; 1. Colors
;
; The colour we see is the light's colour times the colour the surface
; reflects. A coral object under white light stays coral; under green light
; it turns dark green, because coral reflects little green.
;
; The scene is the one the lighting chapter keeps: an object, and a small
; cube standing in for the light. The lamp has a shader of its own, so
; nothing done to the lighting ever darkens it.
;
; From here on the per-draw matrices are `transforms`
; (includes/learn/transforms.rasm), in register b0 for every shader, and
; window_begin binds and clears the backbuffer and depth buffer.
;
;   W A S D, Space, Shift   move
;   right mouse + drag      look
;   wheel                   zoom
import "../../../includes/d3d11.rin"
import "../../../includes/calls.rasm"
import "../../../includes/math.rasm"
import "../../../includes/learn/window.rasm"
import "../../../includes/learn/shader.rasm"
import "../../../includes/learn/gpu.rasm"
import "../../../includes/learn/cube.rasm"
import "../../../includes/learn/camera.rasm"
import "../../../includes/learn/transforms.rasm"

; Mirrors `cbuffer colors` in colors.hlsl: a float3 fills a register only
; with the float after it.
colors_constants: struct = {
    object_color: vec3
    pad0: f32
    light_color: vec3
    pad1: f32
}

camera_start: const vec3 = { -1.0, 1.0, 4.0 }
light_position: const vec3 = { 1.2, 1.0, 2.0 }
clear_color: [4]const f32 = { 0.1, 0.1, 0.1, 1.0 }

t: transforms = {}
colors: colors_constants = {
    .object_color = { 1.0, 0.5, 0.31 },    ; coral
    .light_color = { 1.0, 1.0, 1.0 },      ; under white light
}
lamp_color: const vec4 = { 1.0, 1.0, 1.0, 1.0 }
model: mat4 = {}
lighting_shader: shader = {}
lamp_shader: shader = {}
cam: camera = {}
cube_vb: *ID3D11Buffer = {}
transforms_buffer: *ID3D11Buffer = {}
colors_buffer: *ID3D11Buffer = {}
lamp_buffer: *ID3D11Buffer = {}
stride: u32 = CUBE_STRIDE
offset: u32 = 0

; timing
delta_time: f32 = 0.0
last_frame: f32 = 0.0

main: proc() -> i32 = {
    sub rsp, 56                            ; IASetVertexBuffers: 5 past `this`, 2 on the stack: 32 + 16; entry 8 + 56 lands on 16

    invoke(window_create, "LearnD3D11")
    call window_create_depth

    ; build and compile our shader programs
    ; -------------------------------------
    invoke(shader_create, lighting_shader&, "src/2.lighting/1.colors/colors.hlsl", cube_layout&, CUBE_LAYOUT_COUNT)
    invoke(shader_create, lamp_shader&, "src/2.lighting/1.colors/light_cube.hlsl", cube_layout&, CUBE_LAYOUT_COUNT)

    ; set up vertex data and constant buffers
    ; ---------------------------------------
    invoke(create_buffer, D3D11_BIND_FLAG.D3D11_BIND_VERTEX_BUFFER, cube_vertices&, sizeof(cube_vertices))
    mov cube_vb, rax
    invoke(create_constant_buffer, sizeof(transforms))
    mov transforms_buffer, rax
    invoke(create_constant_buffer, sizeof(colors_constants))
    mov colors_buffer, rax
    invoke(create_constant_buffer, sizeof(vec4))
    mov lamp_buffer, rax

    lea rcx, cam
    lea rdx, camera_start
    movss xmm2, -75.0                      ; yaw
    movss xmm3, -10.0                      ; pitch
    call camera_create

    ; render loop
    ; -----------
  render_loop:
    call window_poll
    test eax, eax
    jz render_loop_done

    ; per-frame time logic
    ; --------------------
    call get_time
    movss xmm1, xmm0
    subss xmm0, last_frame
    movss delta_time, xmm0
    movss last_frame, xmm1

    ; input
    ; -----
    invoke(camera_process_input, cam&, delta_time&)

    ; render
    ; ------
    invoke(window_begin, clear_color&)
    vcall(context, ID3D11DeviceContextVtbl.IASetPrimitiveTopology, D3D11_PRIMITIVE_TOPOLOGY.D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST)
    vcall(context, ID3D11DeviceContextVtbl.IASetVertexBuffers, 0, 1, cube_vb&, stride&, offset&)
    invoke(bind_constants, 0, transforms_buffer)
    invoke(transforms_from_camera, t&, cam&)

    ; the object: coral, under white light
    invoke(update_buffer, colors_buffer, colors&, sizeof(colors_constants))
    invoke(shader_use, lighting_shader&)
    invoke(bind_constants, 1, colors_buffer)
    lea rcx, model
    call m4_identity
    invoke(draw_cube, transforms_buffer, t&, model&)

    ; the lamp: a small white cube where the light is
    invoke(update_buffer, lamp_buffer, lamp_color&, sizeof(vec4))
    invoke(shader_use, lamp_shader&)
    invoke(bind_constants, 1, lamp_buffer)
    lea rcx, model
    lea rdx, light_position
    movss xmm2, 0.2                        ; the scale, the third argument
    call m4_translate_scale
    invoke(draw_cube, transforms_buffer, t&, model&)

    call window_present
    jmp render_loop
  render_loop_done:

    invoke(ExitProcess, 0)
}
